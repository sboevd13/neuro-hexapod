            <geom type="capsule" fromto="0 0 0 0.121 0 0" size="0.008" mass="0.040" rgba="0.7 0.7 0.7 1"/>
            <geom type="sphere" pos="0.121 0 0" size="0.012" mass="0.005" friction="1.8 0.08 0.02" rgba="0.12 0.12 0.12 1"/>
            <site name="elbow_four" pos="0 0 0" size="0.009" rgba="1 0 0 0.5" type="sphere"/>
            <site name="tibia_four_tip" pos="0.121 0 0" size="0.007"/>
          </body>
        </body>
      </body>

      <!-- ML / leg 4: pivot (0, +90.8) mm, neutral radial yaw +90 deg -->
      <body name="Leg_Five_Motor_One" pos="0 0.0908 0" euler="0 0 1.570796327">
        <joint name="Motor_One_Joint_Five" type="hinge" axis="0 0 1" range="-0.7853981634 0.7853981634"/>
        <geom type="box" size="0.020 0.014 0.020" mass="0.055" rgba="0.25 0.25 0.25 1"/>
        <geom type="capsule" fromto="0 0 0 0.051 0 0" size="0.010" mass="0.020" rgba="0.55 0.55 0.55 1"/>
        <body name="Leg_Five_Motor_Two" pos="0.051 0 0" euler="0 -0.666718034 0">
