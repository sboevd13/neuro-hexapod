          <geom type="box" size="0.020 0.014 0.020" mass="0.055" rgba="0.25 0.25 0.25 1"/>
          <geom type="capsule" fromto="0 0 0 0.065 0 0" size="0.009" mass="0.025" rgba="0.65 0.65 0.65 1"/>
          <body name="Leg_Three_Motor_Three" pos="0.065 0 0" euler="0 2.122223468 0">
            <joint name="Joint_Two_Motor_Three" type="hinge" axis="0 1 0" range="-1.221730476 1.221730476"/>
            <geom type="box" size="0.020 0.014 0.020" mass="0.055" rgba="0.25 0.25 0.25 1"/>
            <geom type="capsule" fromto="0 0 0 0.121 0 0" size="0.008" mass="0.040" rgba="0.7 0.7 0.7 1"/>
            <geom type="sphere" pos="0.121 0 0" size="0.012" mass="0.005" friction="1.8 0.08 0.02" rgba="0.12 0.12 0.12 1"/>
            <site name="elbow_three" pos="0 0 0" size="0.009" rgba="1 0 0 0.5" type="sphere"/>
            <site name="tibia_three_tip" pos="0.121 0 0" size="0.007"/>
          </body>
        </body>
      </body>

      <!-- BL / leg 3: pivot (-110.4, +58.4) mm, neutral radial yaw +135 deg -->
      <body name="Leg_Four_Motor_One" pos="-0.1104 0.0584 0" euler="0 0 2.35619449">
        <joint name="Motor_One_Joint_Four" type="hinge" axis="0 0 1" range="-0.7853981634 0.7853981634"/>
        <geom type="box" size="0.020 0.014 0.020" mass="0.055" rgba="0.25 0.25 0.25 1"/>
        <geom type="capsule" fromto="0 0 0 0.051 0 0" size="0.010" mass="0.020" rgba="0.55 0.55 0.55 1"/>
        <body name="Leg_Four_Motor_Two" pos="0.051 0 0" euler="0 -0.666718034 0">
          <joint name="Joint_One_Motor_Four" type="hinge" axis="0 1 0" range="-0.7853981634 0.7853981634"/>
          <geom type="box" size="0.020 0.014 0.020" mass="0.055" rgba="0.25 0.25 0.25 1"/>
          <geom type="capsule" fromto="0 0 0 0.065 0 0" size="0.009" mass="0.025" rgba="0.65 0.65 0.65 1"/>
          <body name="Leg_Four_Motor_Three" pos="0.065 0 0" euler="0 2.122223468 0">
            <joint name="Joint_Two_Motor_Four" type="hinge" axis="0 1 0" range="-1.221730476 1.221730476"/>
