<mujoco model="educate_center_hexapod">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <!-- Firmware uses a 20 ms (50 Hz) control frame. arena.py uses frame_skip=5,
       therefore 4 ms physics steps produce one policy action every 20 ms. -->
  <option timestep="0.004" iterations="50" tolerance="1e-10" solver="Newton" jacobian="sparse" gravity="0 0 -9.81"/>

  <default>
    <joint armature="0.002" damping="0.08" stiffness="0" limited="true"/>
    <geom contype="1" conaffinity="2" condim="3" friction="1.4 0.08 0.02"
          solref="0.006 1" solimp="0.9 0.99 0.001"/>
  </default>

  <asset>
    <texture builtin="gradient" height="100" rgb1=".4 .5 .6" rgb2="0 0 0" type="skybox" width="100"/>
    <texture builtin="checker" height="100" name="texplane" rgb1="0.15 0.15 0.15" rgb2="0.75 0.75 0.75" type="2d" width="100"/>
    <material name="m_arena" reflectance="0.2" texture="texplane"/>
  </asset>

  <worldbody>
    <light diffuse="1 1 1" dir="0 0 -1" directional="true" pos="0 0 2.5"/>
    <geom material="m_arena" name="floor" pos="0 0 0" size="20 20 0.05" type="plane"
          contype="2" conaffinity="1" friction="1.4 0.08 0.02"/>

    <!--
      Coordinate convention:
        MuJoCo +X = robot forward (firmware +X)
        MuJoCo +Y = robot left    (firmware -Y)
        MuJoCo +Z = up

      Real-robot constants from educate-center/hexapod firmware:
        BODY_X = [110.4, 0, -110.4, -110.4, 0, 110.4] mm
        BODY_Y = [ 58.4,90.8, 58.4, -58.4,-90.8,-58.4] mm
        COXA=51 mm, FEMUR=65 mm, TIBIA=121 mm
        HOME_Z=-80 mm

      Leg/action order is deliberately identical to firmware:
        One=FR, Two=MR, Three=BR, Four=BL, Five=ML, Six=FL.
    -->
    <body name="Hexapod_Body" pos="0 0 0.082">
      <camera name="track" mode="trackcom" pos="-0.8 -1.3 0.7" xyaxes="1 0 0 0 0.7 0.7"/>
      <joint name="root" type="free" limited="false" armature="0" damping="0"/>

      <!-- Approximate body/electronics/battery mass. Link masses below include MG996R servos. -->
      <geom name="body_main" type="box" size="0.115 0.095 0.012" pos="0 0 0.012" mass="0.45" rgba="0.75 0.12 0.12 1"/>

      <!-- FR / leg 0: pivot (+110.4, -58.4) mm, neutral radial yaw -45 deg -->
      <body name="Leg_One_Motor_One" pos="0.1104 -0.0584 0" euler="0 0 -0.7853981634">
        <joint name="Motor_One_Joint_One" type="hinge" axis="0 0 1" range="-0.7853981634 0.7853981634"/>
        <geom type="box" size="0.020 0.014 0.020" pos="0 0 0" mass="0.055" rgba="0.25 0.25 0.25 1"/>
        <geom type="capsule" fromto="0 0 0 0.051 0 0" size="0.010" mass="0.020" rgba="0.55 0.55 0.55 1"/>
        <body name="Leg_One_Motor_Two" pos="0.051 0 0" euler="0 -0.666718034 0">
          <joint name="Joint_One_Motor_One" type="hinge" axis="0 1 0" range="-0.7853981634 0.7853981634"/>
          <geom type="box" size="0.020 0.014 0.020" pos="0 0 0" mass="0.055" rgba="0.25 0.25 0.25 1"/>
          <geom type="capsule" fromto="0 0 0 0.065 0 0" size="0.009" mass="0.025" rgba="0.65 0.65 0.65 1"/>
          <body name="Leg_One_Motor_Three" pos="0.065 0 0" euler="0 2.122223468 0">
            <joint name="Joint_Two_Motor_One" type="hinge" axis="0 1 0" range="-1.221730476 1.221730476"/>
            <geom type="box" size="0.020 0.014 0.020" pos="0 0 0" mass="0.055" rgba="0.25 0.25 0.25 1"/>
            <geom type="capsule" fromto="0 0 0 0.121 0 0" size="0.008" mass="0.040" rgba="0.7 0.7 0.7 1"/>
            <geom type="sphere" pos="0.121 0 0" size="0.012" mass="0.005" friction="1.8 0.08 0.02" rgba="0.12 0.12 0.12 1"/>
            <site name="elbow_one" pos="0 0 0" size="0.009" rgba="1 0 0 0.5" type="sphere"/>
            <site name="tibia_one_tip" pos="0.121 0 0" size="0.007"/>
          </body>
        </body>
      </body>

      <!-- MR / leg 1: pivot (0, -90.8) mm, neutral radial yaw -90 deg -->
      <body name="Leg_Two_Motor_One" pos="0 -0.0908 0" euler="0 0 -1.570796327">
        <joint name="Motor_One_Joint_Two" type="hinge" axis="0 0 1" range="-0.7853981634 0.7853981634"/>
        <geom type="box" size="0.020 0.014 0.020" mass="0.055" rgba="0.25 0.25 0.25 1"/>
        <geom type="capsule" fromto="0 0 0 0.051 0 0" size="0.010" mass="0.020" rgba="0.55 0.55 0.55 1"/>
        <body name="Leg_Two_Motor_Two" pos="0.051 0 0" euler="0 -0.666718034 0">
          <joint name="Joint_One_Motor_Two" type="hinge" axis="0 1 0" range="-0.7853981634 0.7853981634"/>
          <geom type="box" size="0.020 0.014 0.020" mass="0.055" rgba="0.25 0.25 0.25 1"/>
          <geom type="capsule" fromto="0 0 0 0.065 0 0" size="0.009" mass="0.025" rgba="0.65 0.65 0.65 1"/>
          <body name="Leg_Two_Motor_Three" pos="0.065 0 0" euler="0 2.122223468 0">
            <joint name="Joint_Two_Motor_Two" type="hinge" axis="0 1 0" range="-1.221730476 1.221730476"/>
            <geom type="box" size="0.020 0.014 0.020" mass="0.055" rgba="0.25 0.25 0.25 1"/>
            <geom type="capsule" fromto="0 0 0 0.121 0 0" size="0.008" mass="0.040" rgba="0.7 0.7 0.7 1"/>
            <geom type="sphere" pos="0.121 0 0" size="0.012" mass="0.005" friction="1.8 0.08 0.02" rgba="0.12 0.12 0.12 1"/>
            <site name="elbow_two" pos="0 0 0" size="0.009" rgba="1 0 0 0.5" type="sphere"/>
            <site name="tibia_two_tip" pos="0.121 0 0" size="0.007"/>
          </body>
        </body>
      </body>

      <!-- BR / leg 2: pivot (-110.4, -58.4) mm, neutral radial yaw -135 deg -->
      <body name="Leg_Three_Motor_One" pos="-0.1104 -0.0584 0" euler="0 0 -2.35619449">
