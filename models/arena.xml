        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- MG996R-like position servos. 1.1 N·m is a conservative nominal torque cap. -->
    <position name="FR_coxa"  joint="Motor_One_Joint_One"   kp="22" ctrlrange="-0.7853981634 0.7853981634" ctrllimited="true" forcerange="-1.1 1.1" forcelimited="true"/>
    <position name="FR_femur" joint="Joint_One_Motor_One"   kp="22" ctrlrange="-0.7853981634 0.7853981634" ctrllimited="true" forcerange="-1.1 1.1" forcelimited="true"/>
    <position name="FR_tibia" joint="Joint_Two_Motor_One"   kp="22" ctrlrange="-1.221730476 1.221730476" ctrllimited="true" forcerange="-1.1 1.1" forcelimited="true"/>
    <position name="MR_coxa"  joint="Motor_One_Joint_Two"   kp="22" ctrlrange="-0.7853981634 0.7853981634" ctrllimited="true" forcerange="-1.1 1.1" forcelimited="true"/>
