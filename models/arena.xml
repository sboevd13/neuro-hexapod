      <!-- FL / leg 5: pivot (+110.4, +58.4) mm, neutral radial yaw +45 deg -->
      <body name="Leg_Six_Motor_One" pos="0.1104 0.0584 0" euler="0 0 0.7853981634">
        <joint name="Motor_One_Joint_Six" type="hinge" axis="0 0 1" range="-0.7853981634 0.7853981634"/>
        <geom type="box" size="0.020 0.014 0.020" mass="0.055" rgba="0.25 0.25 0.25 1"/>
        <geom type="capsule" fromto="0 0 0 0.051 0 0" size="0.010" mass="0.020" rgba="0.55 0.55 0.55 1"/>
        <body name="Leg_Six_Motor_Two" pos="0.051 0 0" euler="0 -0.666718034 0">
          <joint name="Joint_One_Motor_Six" type="hinge" axis="0 1 0" range="-0.7853981634 0.7853981634"/>
